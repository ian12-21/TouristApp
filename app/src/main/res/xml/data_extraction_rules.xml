<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignores allowBackup="false" for device-to-device transfer, so these rules leave
     everything out of both. A copied tablet would show the same apartment and, with Firebase
     Auth's saved session, sign in as the same anonymous user that may edit this tablet's reviews. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
